def bubble_sort(arr):
    n = len(arr)

    for i in range(n - 1):
        swapped = False

        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                # Swap elements
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        # If no swapping happens, array is already sorted
        if not swapped:
            break

    return arr


# Example
nums = [5, 2, 8, 1, 3]

print("Sorted Array:", bubble_sort(nums))
